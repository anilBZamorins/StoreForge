APP_NAME=StoreForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Angular apps (Stripe Checkout success/cancel redirects)
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Landlord database (SuperAdmin / platform control) ----------
# Holds plans, tenants (stores), users, subscription invoices, registrations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storeforge
DB_USERNAME=root
DB_PASSWORD=
# The MySQL user needs CREATE DATABASE privilege - tenant databases are
# created automatically at provisioning as {TENANT_DB_PREFIX}{slug}.
TENANT_DB_PREFIX=storeforge_

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@storeforge.io"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Stripe (tenant registration checkout) ----------
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=usd
